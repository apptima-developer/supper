# Required in production. Use at least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required in production. A separate random value used to hash login throttle keys.
RATE_LIMIT_PEPPER=replace-with-a-different-32-character-random-value

# Required in production. Exact public HTTPS origin, without a path or trailing slash.
APP_ORIGIN=https://app.example.com

# Request limits. Defaults shown here may be adjusted deliberately per deployment.
MAX_JSON_BODY_KB=512
MAX_IMPORT_FILE_MB=20
MAX_INLINE_IMAGE_MB=2

# Storage mode:
# - local-json: read/write data/ on the local filesystem
# - supabase: read/write public.app_store JSONB rows
# - supabase-relational: read/write relational support_* tables
DATA_BACKEND=local-json

# Required only when DATA_BACKEND is supabase or supabase-relational.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional safe build diagnostics. Invalid values are omitted from health metadata.
# APP_BUILD_SHA accepts a 7-64 character hexadecimal commit SHA.
APP_BUILD_SHA=
# APP_BUILD_TIMESTAMP accepts an ISO-compatible build timestamp.
APP_BUILD_TIMESTAMP=
# VERCEL_GIT_COMMIT_SHA and VERCEL_ENV are supplied automatically by Vercel when available.

# Manually executed AI-development bootstrap only. Leave disabled by default.
# Never place a real bootstrap password in this committed file.
APP_ENV=
AI_ENABLED=false
ALLOW_INSECURE_DEV_BOOTSTRAP=false
DEV_BOOTSTRAP_TARGET_PROJECT_REF=
DEV_BOOTSTRAP_ADMIN_USERNAME=
DEV_BOOTSTRAP_ADMIN_PASSWORD=
DEV_BOOTSTRAP_ADMIN_EMAIL=

# Server-only ServiceNow diagnostic connector. Basic auth is for isolated PDI use only.
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=
SERVICENOW_AUTH_MODE=basic
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TIMEOUT_MS=15000
SERVICENOW_PAGE_SIZE=100
SERVICENOW_INCIDENT_TABLE=incident

# AI-development-only bounded Incident synchronization. Diagnostic reads above
# continue to work while this separate switch remains false.
SERVICENOW_SYNC_ENABLED=false
SERVICENOW_SYNC_INITIAL_LOOKBACK_DAYS=30
SERVICENOW_SYNC_OVERLAP_SECONDS=120
SERVICENOW_SYNC_MAX_RECORDS=1000
SERVICENOW_SYNC_MAX_PAGES=20
SERVICENOW_SYNC_LOCK_TTL_SECONDS=300

# AI-2.0 controlled write kernel. Live provider mutation is disabled by default.
# Dry-run command validation remains available while the live-write switch is false.
SERVICENOW_WRITE_ENABLED=false
SERVICENOW_WRITE_MAX_ATTEMPTS=3
