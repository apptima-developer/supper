{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlySnapshotPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": "REPLACE_PREFIX/*" } }
    },
    {
      "Sid": "ReadAndPublishOnlySnapshots",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/REPLACE_PREFIX/*"
    },
    {
      "Sid": "NeverDeleteSnapshotVersions",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/REPLACE_PREFIX/*"
    },
    {
      "Sid": "RequireConditionalPublication",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/REPLACE_PREFIX/*",
      "Condition": { "Null": { "s3:if-none-match": "true" } }
    },
    {
      "Sid": "DenyPlaintextTransport",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::REPLACE_PRIVATE_BUCKET", "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
